# NOTES: 
# - Do not use double-quotes and do not delete any of the variables.
# - Make sure that NEXTAUTH_URL=http://localhost:3000 has no comments in the same line.

# Update your Azure OpenAI details
# AZURE_OPENAI_API_INSTANCE_NAME should be just the name of azure openai resource and not the full url; 
# AZURE_OPENAI_API_DEPLOYMENT_NAME should be deployment name from your azure openai studio and not the model name.
# AZURE_OPENAI_API_VERSION should be Supported versions checkout docs https://learn.microsoft.com/en-us/azure/ai-services/openai/reference
AZURE_OPENAI_API_KEY=111111
AZURE_OPENAI_API_INSTANCE_NAME=azurechat
AZURE_OPENAI_API_MINI_DEPLOYMENT_NAME=gpt-5.4-mini
AZURE_OPENAI_API_VERSION=2023-12-01-preview
AZURE_OPENAI_API_EMBEDDINGS_DEPLOYMENT_NAME=text-embedding-3-large

# New v1 API model deployments for Responses API
AZURE_OPENAI_API_GPT52_DEPLOYMENT_NAME=gpt-5.2
AZURE_OPENAI_API_GPT56_SOL_DEPLOYMENT_NAME=gpt-5.6-sol
AZURE_OPENAI_API_GPT56_TERRA_DEPLOYMENT_NAME=gpt-5.6-terra
AZURE_OPENAI_API_GPT56_LUNA_DEPLOYMENT_NAME=gpt-5.6-luna
AZURE_OPENAI_API_GPT55_DEPLOYMENT_NAME=gpt-5.5
AZURE_OPENAI_API_GPT54_DEPLOYMENT_NAME=gpt-5.4
AZURE_OPENAI_API_GPT54_MINI_DEPLOYMENT_NAME=gpt-5.4-mini
AZURE_OPENAI_API_GPT41_DEPLOYMENT_NAME=gpt-4.1
AZURE_OPENAI_API_GPT41_MINI_DEPLOYMENT_NAME=gpt-4.1-mini
AZURE_OPENAI_API_GPT41_NANO_DEPLOYMENT_NAME=gpt-41-nano
AZURE_OPENAI_GPT_IMAGE_DEPLOYMENT_NAME=gpt-image-1

# --- Cost-control downgrade --------------------------------------------------
# Foundry-hosted low-cost models (DeepSeek/Kimi) used as automatic downgrade
# targets. OpenAI-compatible Chat Completions on the Foundry host's /openai/v1
# surface; Bearer API-key auth. Leave unset to disable Foundry downgrade
# targets (gpt-5.6-luna still works as a hardCapEligible Azure fallback).
FOUNDRY_OPENAI_BASE_URL=https://<resource>.services.ai.azure.com/openai/v1
FOUNDRY_API_KEY=
FOUNDRY_DEEPSEEK_DEPLOYMENT_NAME=DeepSeek-V4-Pro
FOUNDRY_KIMI_DEPLOYMENT_NAME=Kimi-K2.6-1
FOUNDRY_GROK_DEPLOYMENT_NAME=grok-4.3
# Per-user cost budget (USD). Crossing either window downgrades all the user's
# requests to the cheapest hardCapEligible model until the window resets.
# 0 or unset disables that window. Data-derived starting point: 3 / 7.
DOWNGRADE_DAILY_COST_USD=
DOWNGRADE_WEEKLY_COST_USD=
# Optional ordered allow-list constraining/reordering the hardCapEligible set.
DOWNGRADE_HARDCAP_MODELS=
# Intent-based downgrade targets (applied only when no explicit model pick).
DOWNGRADE_INTENT_CODING_MODEL=
DOWNGRADE_INTENT_DEFAULT_MODEL=

# --- Anthropic (Claude) via Azure /anthropic Messages API -------------------
# Resource defaults to AZURE_OPENAI_API_INSTANCE_NAME. Key auth via x-api-key.
AZURE_ANTHROPIC_RESOURCE_NAME=
AZURE_ANTHROPIC_API_KEY=
AZURE_ANTHROPIC_OPUS48_DEPLOYMENT_NAME=claude-opus-4-8
AZURE_ANTHROPIC_SONNET5_DEPLOYMENT_NAME=claude-sonnet-5

# DALL-E image creation endpoint config
AZURE_OPENAI_DALLE_API_KEY=222222
AZURE_OPENAI_DALLE_API_INSTANCE_NAME=azurechat-dall-e
AZURE_OPENAI_DALLE_API_DEPLOYMENT_NAME=dall-e
AZURE_OPENAI_DALLE_API_VERSION=2023-12-01-preview

# GPT4 V OpenaAI details
AZURE_OPENAI_VISION_API_KEY=333333
AZURE_OPENAI_VISION_API_INSTANCE_NAME=azurechat-vision
AZURE_OPENAI_VISION_API_DEPLOYMENT_NAME=gpt-4-vision
AZURE_OPENAI_VISION_API_VERSION=2023-12-01-preview

# Update your admin email addresses - comma separated
ADMIN_EMAIL_ADDRESS=you@email.com,you2@email.com

# Agent trust management: object ID of the Entra ID group whose members may
# verify/downgrade/unpublish organization-published agents. May be a
# security group. Leave empty to disable trust actions for everyone.
AGENT_VERIFIER_GROUP_ID=

# Identity provider is optional if you are running in development mode locally (npm run dev)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# Update your production URL in NEXTAUTH_URL
NEXTAUTH_SECRET=AZURE-OPENIAI-NEXTAUTH-OWNKEY@1
# in production, this should be your production URL e.g. https://azurechat.azurewebsites.net
NEXTAUTH_URL=http://localhost:3000

# Update your Cosmos Environment details here
AZURE_COSMOSDB_URI=https://<cosmoresourcename>.documents.azure.com:443/
AZURE_COSMOSDB_KEY=

# Update your Cosmos variables if you want to overwrite the default values
AZURE_COSMOSDB_DB_NAME=chat
AZURE_COSMOSDB_CONTAINER_NAME=history
AZURE_COSMOSDB_CONFIG_CONTAINER_NAME=config

# Azure AI Search  is used for chat over your data
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_NAME=
AZURE_SEARCH_INDEX_NAME=

# Azure AI Document Intelligence to extract content from your data
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://NAME.api.cognitive.microsoft.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=


# Azure Speech to Text to convert audio to text
AZURE_SPEECH_REGION=
AZURE_SPEECH_KEY=

# Azure Storage account to store files
AZURE_STORAGE_ACCOUNT_NAME=azurechat
AZURE_STORAGE_ACCOUNT_KEY=123456

# Azure Key Vault to store secrets
AZURE_KEY_VAULT_NAME=

# max upload document size in bytes
MAX_UPLOAD_DOCUMENT_SIZE=10485760 # 10MB
NEXT_PUBLIC_MAX_UPLOAD_DOCUMENT_SIZE=10485760 # 10MB

MAX_PERSONA_DOCUMENT_LIMIT=25
MAX_PERSONA_DOCUMENT_SIZE=10485760 # 10MB
NEXT_PUBLIC_MAX_PERSONA_DOCUMENT_LIMIT=25

# Code Interpreter persona documents: keep server/public limits in sync
MAX_PERSONA_CI_DOCUMENT_LIMIT=20
MAX_PERSONA_CI_DOCUMENT_SIZE=536870912 # 512MB
NEXT_PUBLIC_MAX_PERSONA_CI_DOCUMENT_LIMIT=20
NEXT_PUBLIC_MAX_PERSONA_CI_DOCUMENT_SIZE=536870912 # 512MB

NEXT_PUBLIC_FEEDBACK_LINK=""
NEXT_PUBLIC_AI_RULES=""
NEXT_PUBLIC_SHAREPOINT_URL=""

# ── Chat history budget ──────────────────────────────────────────────────────
# Ceiling on the size of the prompt a thread may carry. Not a context limit
# -- the 5.6 family holds ~1M tokens -- but a cost limit: history is re-sent
# every turn, and whenever the prompt cache entry is evicted the next turn
# rewrites the whole prompt at 1.25x the uncached input rate.
#
# What is compared against it is a MEASUREMENT, never an estimate: the
# provider's own size for the last prompt of this thread's previous request
# (the final step's inputTokens, which the app persists per thread). Not the
# turn's billed input, because the AI SDK sums usage over every step of a turn
# -- a 3-step tool turn bills three prompts for a conversation that never
# exceeded one, and using that sum compacted threads that were never over
# budget.
#
# Above this, and only above this, the thread's eligible history is compacted
# (and summarised, if HISTORY_SUMMARY_ENABLED) and the thread starts again from
# the summary. There is no target to land on and no fraction of the budget:
# the next request measures the new prompt, so a compaction that was not enough
# simply compacts again on the next turn. Compaction is lossy, so the default
# is deliberately late: 256000.
#
# A thread with no measurement yet -- its first turn, or a row written before
# the app recorded one -- is never compacted. There is nothing to compare, and
# an oversized first message could not be helped anyway (see
# HISTORY_PROTECTED_TURNS).
#
# Optional. Default 256000. A per-model override may be set in models.ts
# (historyTokenBudget); this variable wins over both. Whatever is configured is
# then BOUNDED by the model that answers -- see HISTORY_LONG_CONTEXT_RESERVE --
# so this cannot raise the budget past what the model can afford to be handed.
HISTORY_TOKEN_BUDGET=256000

# Tokens held back from the model's own ceiling for everything in the prompt
# that is NOT carried history: the developer message (static prompt, persona,
# instruction blocks, tool definitions), the document hint, and the current
# turn.
#
# The effective budget is min(configured budget, model guard), where the guard
# is:
#   longContextThresholdTokens - this reserve, for a model that declares one.
#     Azure bills GPT-5.6 input above 272000 tokens at a separate "long
#     context" tier at 2x the normal rate (the LongCo* meters), so 272000 -
#     16000 = 256000 keeps a thread clear of the cliff. Nothing fails when it
#     is crossed -- the invoice just doubles for the whole request, cached
#     tokens included -- and carrying history over the line is the worst way to
#     cross it, since history is re-sent every turn.
#   60 % of contextWindow, for a model that declares no threshold. That is a
#     correctness guard, not a cost one: overflowing the window is an HTTP 400.
#     The other 40 % is for the developer message, the current turn, tool
#     results and the reply (thinking tokens included).
# So: GPT-5.6 (any) 256000; Claude 256000 (its 600000 guard is higher than the
# default, so the default wins); a 128k-window model 76800.
# Optional. Default 16000. An explicit 0 is honoured; junk is ignored.
HISTORY_LONG_CONTEXT_RESERVE=16000

# (There is no trim-target setting any more. A compaction takes the whole
# eligible history rather than cutting down to a fraction of the budget, so
# there is no target to configure: the measured prompt size makes one
# unnecessary. The hysteresis it used to provide is now free -- after a
# compaction the prompt is the developer message, the summary and the current
# turn, so it stays cacheable for the dozens of turns it takes to grow back to
# the budget.)

# How many of the newest PERSISTED turns a compaction may never drop.
#
# Default 0, and that is the important part. Over the budget, everything else
# is compacted in one go: the eligible history leaves the prompt, a summary
# stands in for it, and the thread starts again from there.
#
# The message the user just sent is safe whatever this says -- it is written to
# Cosmos after history is read, so the compaction never sees it -- and "0"
# therefore means "every persisted turn is eligible", not "the current question
# can be deleted".
#
# It used to be 2, and that produced a trim that made the prompt BIGGER: on a
# thread whose newest turn was a 15k-token paste, the trimmer had to spare the
# paste, so it dropped a small older turn, added a ~2k summary, and the next
# prompt came out at 17.5k against 17k before -- every turn, with a fresh
# summariser call each time. Protecting turns from a COST cut is a
# contradiction: the expensive turn is the one that has to go, and at 0 it does.
#
# Set it to 2 to get a protected tail back. Whatever it is, nothing happens
# when there is no eligible history left to compact -- no summariser call is
# spent and no notice is shown (INFO, or WARN on the shipped default budget,
# "prompt over budget but nothing can be compacted"). That is also the answer
# for a single message too big for the budget on its own: the current turn is
# never droppable, so a compaction cannot help it.
# Optional. Default 0. Non-integer or negative values are ignored.
HISTORY_PROTECTED_TURNS=0

# Summarise the block of turns a compaction removes, so its facts, decisions,
# open questions, document names and user preferences survive. The summary is
# persisted once per compaction and replayed verbatim on later turns, so it
# costs one extra model call every few dozen turns rather than one per turn.
# Optional. Default off; set to exactly "true" to enable. With it off an
# over-budget thread is still compacted, it just loses the dropped block.
HISTORY_SUMMARY_ENABLED=false

# Deployment used for those summaries. Optional. By default the summary runs
# on THE THREAD'S OWN MODEL, then falls back to Terra, then Luna, then the
# deployment already used for thread titles. Setting this pins one deployment
# for every thread and beats all of that.
#
# The thread's own model, because the block being summarised is the block that
# model just had in context: sending it elsewhere pays for every one of those
# tokens again, cold, and the summary is the only thing that stands in for the
# dropped turns, so it is the wrong place to save a few cents. The summariser
# goes through the same provider seam as the chat itself, so a Claude or
# Foundry thread summarises on its own model too.
#
# A name set here must belong to a model in models.ts -- the seam builds the
# client from the model, not from the string. A name no model owns is skipped
# with a warning and the next candidate is used, rather than 404ing on every
# compaction (which is exactly what the legacy chat-completions client did to the
# GPT-5.6 deployments: they are served on /openai/v1, not on the
# *.openai.azure.com api-version surface).
#
# The summariser's tokens are NOT billed to the user: they reach neither the
# daily cost cap nor the usage figure in the chat header. The user did not ask
# for the call; the budget did, to make their thread cheaper. They ARE reported
# as the `historySummaryTokens` metric (dimensions: hashed user id, chatModel,
# threadId, direction input/output), because "not billed to the user" must not
# mean "invisible".
HISTORY_SUMMARY_DEPLOYMENT_NAME=

# How long that summariser call gets before the compaction gives up on it. The
# call sits ON THE REQUEST PATH -- it runs before the stream starts, so every
# millisecond is a millisecond the user waits for a first token. On a timeout
# the watermark is still written, so the compaction still sticks and the prompt
# is still cheap; only the summary text is lost, which is what leaving
# HISTORY_SUMMARY_ENABLED off costs anyway.
# Optional. Default 20000. Absent, unparseable or non-positive is ignored.
HISTORY_SUMMARY_TIMEOUT_MS=20000

# -- Model default and reasoning ---------------------------------------------
# The model a turn runs on when the request, the thread and the picker all say
# nothing. Optional. Defaults to the code default, gpt-5.6-terra. Must be an id
# from MODEL_CONFIGS that also has a deployment name set in this environment;
# an unknown or undeployed id is logged and ignored.
DEFAULT_MODEL_ID=

# Per-model reasoning effort, as a JSON object of model id -> effort, e.g.
# {"gpt-5.6-terra":"high","gpt-5.6-luna":"low"}. Optional. Overrides the
# defaultReasoningEffort in models.ts and is itself overridden by the user's
# own pick in the picker. Unparseable JSON yields an empty map; an unknown
# model id or a level that model does not accept is dropped with a warning,
# because a level the model rejects is an HTTP 400 on every turn.
REASONING_EFFORT_OVERRIDES=

# Per-model ceiling on the tokens ONE TURN may emit, as a JSON object of model
# id -> positive integer, e.g. {"gpt-5.6-terra":48000}. Optional; overrides the
# maxOutputTokens in models.ts. A value that is not a positive integer is
# dropped with a warning (0 is not "no limit" -- it is a turn that can emit
# nothing).
# Reasoning tokens count against this budget on the Responses API, and thinking
# counts against it on Anthropic, so a turn at high effort can spend most of it
# thinking and be cut off. Shipped: 32000 for the 5.6 family and 5.5, 16000 for
# Claude and gpt-5.4, 8000 for the small models. A cut-off reply says so and is
# counted as the truncatedTurns metric.
MAX_OUTPUT_TOKENS_OVERRIDES=

# -- Prompt cache key --------------------------------------------------------
# What the OpenAI prompt_cache_key is derived from.
#   thread  (default) one key per conversation.
#   persona          one key per agent, SHARDED, so the second thread of an
#                    agent reads the system+tools prefix the first one wrote.
# Only GPT-5.6 takes the persona strategy; every other model keeps the thread
# id whatever this says. Anything unrecognised means "thread".
PROMPT_CACHE_KEY_STRATEGY=thread

# Buckets the persona key is sharded across. Azure rate-limits one key+prefix
# to roughly 15 requests/minute, so a popular agent on a single key would
# throttle. A user is assigned a bucket deterministically from their HASHED id
# (never the email), so they keep reading their own warm prefix.
# Optional. Default 4. A non-numeric, zero or negative value is ignored.
PROMPT_CACHE_KEY_SHARDS=4

# Pin a prompt-cache breakpoint at the end of the static developer/system
# prefix on whichever provider serves the turn, so the system+tools block
# shared by every thread of an agent is one cache unit. A breakpoint is not an
# OpenAI concept -- both providers we serve have one, only the wire field
# differs:
#   Azure OpenAI Responses  providerOptions.openai.promptCacheBreakpoint
#                           {mode:"explicit"} on the developer message
#   Anthropic Messages      providerOptions.anthropic.cacheControl
#                           (cache_control) on the system block
# NO-OP ON ANTHROPIC: Claude caches nothing without an explicit breakpoint, so
# the /anthropic seam pins the system-prefix breakpoint on every turn whatever
# this is set to. The flag only gates the Responses seam, which already gets
# automatic prefix caching from promptCacheKey and therefore has a version of
# the request worth comparing against.
# Optional. Default off; set to exactly "true" to enable.
# OFF ON PURPOSE: on the Responses seam the breakpoint's own wire field is
# mode:"explicit" while the request-level prompt_cache_options stays
# mode:"implicit", and that pairing has not been verified against Azure. Turn
# it on only alongside a live check of the cache-read share.
PROMPT_CACHE_PERSONA_BREAKPOINT=false
